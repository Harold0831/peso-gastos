# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (login + Gmail por usuario) — ver CLAUDE.md § Configurar Google
# El mismo client sirve para "Continuar con Google" y para leer Gmail.
# Requiere el redirect URI <origen>/api/auth/google/callback en Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Cifra los refresh tokens de Gmail guardados en la DB — genera con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Gmail Push (sync automático en tiempo real, ver CLAUDE.md § Gmail Push)
GMAIL_PUBSUB_TOPIC=projects/TU-PROYECTO/topics/qik-sync
GMAIL_WEBHOOK_AUDIENCE=https://tu-dominio.vercel.app/api/gmail-webhook

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Protege /api/sync (llamadas externas manuales) — genera con: openssl rand -hex 32
SYNC_SECRET=

# Protege /api/admin/mint-token (genera el token de API de un usuario para el
# Shortcut de iOS, ver CLAUDE.md § Captura por voz) — genera con: openssl rand -hex 32
ADMIN_SECRET=

# Protege /api/gmail-watch/renew — Vercel Cron lo envía automáticamente
# como Bearer SOLO si la variable se llama exactamente CRON_SECRET (no la
# renombres). genera con: openssl rand -hex 32
CRON_SECRET=

# Firma la cookie de sesión — genera con: openssl rand -base64 32
SESSION_SECRET=

# Notificaciones push (opcional) — genera el par con: npx web-push generate-vapid-keys
# Sin estas claves, la sección "Notificaciones" del perfil no aparece y todo
# lo demás funciona igual. La pública la usa el navegador al suscribirse.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contacto que los servicios de push pueden usar si hay un problema
# con tus envíos (opcional; por defecto un placeholder). Pon el tuyo.
VAPID_CONTACT_EMAIL=
